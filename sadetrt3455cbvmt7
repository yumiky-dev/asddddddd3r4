local function playEmoteByID(animId)
    task.spawn(function()
        pcall(function()
            local char = localPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildWhichIsA("Humanoid")
            if not hum then return end
            local animator = hum:FindFirstChildWhichIsA("Animator")
            if not animator then
                animator = Instance.new("Animator")
                animator.Parent = hum
            end
            if currentEmoteTrack and currentEmoteTrack.IsPlaying then
                currentEmoteTrack:Stop()
            end
            local a = Instance.new("Animation")
            a.AnimationId = "rbxassetid://" .. tostring(animId)
            local ok, tr = pcall(function() return animator:LoadAnimation(a) end)
            if not ok or not tr then return end
            tr.Priority = Enum.AnimationPriority.Action4
            tr:Play()
            currentEmoteTrack = tr

            local mc
            mc = runService.Heartbeat:Connect(function()
                if not currentEmoteTrack or not currentEmoteTrack.IsPlaying then
                    mc:Disconnect(); return
                end
                local ch = localPlayer.Character
                if not ch then mc:Disconnect(); return end
                local rp = ch:FindFirstChild("HumanoidRootPart")
                if not rp then mc:Disconnect(); return end
                if rp.Velocity.Magnitude > 0.5 then
                    currentEmoteTrack:Stop(0.2)
                    currentEmoteTrack = nil
                    mc:Disconnect()
                end
            end)
        end)
    end)
end

local function stopEmote()
    if currentEmoteTrack and currentEmoteTrack.IsPlaying then
        currentEmoteTrack:Stop(0.2)
    end
    currentEmoteTrack = nil
end

