local _refreshScheduled = false
local function refreshPlayerLists()
    if _refreshScheduled then return end
    _refreshScheduled = true

    task.defer(function()
        task.wait(0.15)

        local ok, err = pcall(function()
            local names = getAllPlayerNames()
            table.sort(names)

            local nameSet = {}
            for _, n in ipairs(names) do nameSet[n] = true end

            local function cleanFlag(flag)
                local list = library.flags[flag]
                if type(list) == "table" then
                    for i = #list, 1, -1 do
                        if not nameSet[list[i]] then table.remove(list, i) end
                    end
                end
            end
            cleanFlag("targets_list")
            cleanFlag("whitelist_list")
            cleanFlag("hosts_list")

            for _, pair in ipairs({
                { "targets_list",   names },
                { "whitelist_list", names },
                { "hosts_list",     names },
            }) do
                local flag, vals = pair[1], pair[2]
                local opt = library.options[flag]
                if opt then
                    opt.values = vals
                    local filter = ""
                    if opt.searchBox and opt.searchBox.Text and opt.searchBox.Text ~= "" then
                        filter = opt.searchBox.Text
                    end
                    opt.refresh(vals, filter)
                    if opt.updateCounter then opt.updateCounter() end
                end
            end

            applyRolesFromLists()
        end)

        _refreshScheduled = false
        if not ok then
            warn("[averon hub] refreshPlayerLists error:", err)
        end
    end)
end

