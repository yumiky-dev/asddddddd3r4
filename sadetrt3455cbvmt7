    local MOD_USERNAMES = {
        ['boomffa_mod']=true,['boomffaadmin']=true,['boomffa_admin']=true,
        ['boomffa_staff']=true,['boom_moderator']=true,['boomgamemod']=true,
    }
    local MOD_SYMBOLS = { 'A','B','C' }
    local MOD_GROUP_IDS = { 925309458, 33991282, 7431102 }
    local MOD_MIN_RANK = 1

    local function hasModSymbols(name)
        for _, sym in ipairs(MOD_SYMBOLS) do
            if string.find(name, sym, 1, true) then return true end
        end
        return false
    end

    local function checkAdmin(player)
        local nl, dl = player.Name:lower(), player.DisplayName:lower()
        if MOD_USERNAMES[nl] or MOD_USERNAMES[dl] then return true, "Known Mod" end
        if hasModSymbols(player.Name) or hasModSymbols(player.DisplayName) then return true, "Mod Symbol" end
        for _, gid in ipairs(MOD_GROUP_IDS) do
            local ok, inGroup = pcall(function() return player:IsInGroup(gid) end)
            if ok and inGroup then
                local rk, rank = pcall(function() return player:GetRankInGroup(gid) end)
                local ro, role = pcall(function() return player:GetRoleInGroup(gid) end)
                local rn = (ro and role) or "GroupMember"
                if rk and rank >= MOD_MIN_RANK then return true, rn .. " [" .. tostring(rank) .. "]" end
            end
        end
        return false, nil
    end

