            local btnAll, btnNone
            if bulk then
                btnAll = Instance.new("TextButton")
                btnAll.Parent = frame
                btnAll.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                btnAll.BorderColor3 = Color3.fromRGB(60, 60, 60)
                btnAll.BorderSizePixel = 1
                btnAll.Position = UDim2.new(0, 3, 1, -23)
                btnAll.Size = UDim2.new(0.5, -4, 0, 20)
                btnAll.Font = Enum.Font.Code
                btnAll.Text = "All"
                btnAll.TextColor3 = Color3.fromRGB(200, 200, 200)
                btnAll.TextSize = 12
                btnAll.AutoButtonColor = false
                btnAll.ZIndex = library.multiZindex + 2

                btnNone = Instance.new("TextButton")
                btnNone.Parent = frame
                btnNone.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
                btnNone.BorderColor3 = Color3.fromRGB(60, 60, 60)
                btnNone.BorderSizePixel = 1
                btnNone.Position = UDim2.new(0.5, 1, 1, -23)
                btnNone.Size = UDim2.new(0.5, -4, 0, 20)
                btnNone.Font = Enum.Font.Code
                btnNone.Text = "None"
