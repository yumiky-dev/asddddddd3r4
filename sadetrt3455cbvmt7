            button.TextColor3 = Color3.fromRGB(155, 155, 155)
            button.TextSize = 13
            button.TextStrokeTransparency = 0
            button.TextXAlignment = Enum.TextXAlignment.Right

            local function updateValue(val)
                if library.colorpicking then return end
                library.flags[args.flag] = val
                if val == Enum.KeyCode.Unknown then
                    button.Text = "--"
                else
                    button.Text = keyNames[val] or val.Name
                end
            end

            library.keybinds[args.flag] = {
                next_    = false,
                button   = button,
                callback = args.callback,
            }

            button.MouseButton1Click:Connect(function()
                if library.colorpicking then return end
                library.flags[args.flag] = Enum.KeyCode.Unknown
                button.Text = "..."
                button.TextColor3 = Color3.new(0.2, 0.2, 0.2)
                library.keybinds[args.flag].next_ = true
            end)

            library.flags[args.flag] = Enum.KeyCode.Unknown
            library.options[args.flag] = {
                type = "keybind", changeState = updateValue,
                skipflag = args.skipflag, oldargs = args
            }
            updateValue(args.key or Enum.KeyCode.Unknown)
        end

        function group:addCreditRow(args)
            if not args.image then return warn("missing args on credit row") end
            local rowH = args.height or 56
