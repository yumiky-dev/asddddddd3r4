local function SubscribePlayer(a, r)
    if a then table.insert(OnPlayerAdded, a) end
    if r then table.insert(OnPlayerRemoving, r) end
end
players.PlayerAdded:Connect(function(p) for i=1,#OnPlayerAdded do OnPlayerAdded[i](p) end end)
