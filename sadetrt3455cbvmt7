            avatar.Image = args.image
            avatar.ZIndex = library.multiZindex + 1
            avatar.ScaleType = Enum.ScaleType.Crop
            Instance.new("UICorner", avatar).CornerRadius = UDim.new(1, 0)

            local s = Instance.new("UIStroke")
            s.Color = library.libColor
            s.Thickness = 1.5
            s.Transparency = 0.2
            s.Parent = avatar

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Parent = row
            nameLbl.BackgroundTransparency = 1
            nameLbl.Position = UDim2.new(0, 56, 0, 8)
            nameLbl.Size = UDim2.new(1, -64, 0, 18)
            nameLbl.Font = Enum.Font.Code
            nameLbl.Text = args.text or ""
            nameLbl.TextColor3 = Color3.fromRGB(244, 244, 244)
            nameLbl.TextSize = 13
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.TextStrokeTransparency = 0
            nameLbl.ZIndex = library.multiZindex + 1

            local roleLbl = Instance.new("TextLabel")
            roleLbl.Parent = row
            roleLbl.BackgroundTransparency = 1
            roleLbl.Position = UDim2.new(0, 56, 0, 26)
            roleLbl.Size = UDim2.new(1, -64, 0, 16)
            roleLbl.Font = Enum.Font.Code
            roleLbl.Text = args.sub or ""
            roleLbl.TextColor3 = library.libColor
            roleLbl.TextSize = 11
            roleLbl.TextXAlignment = Enum.TextXAlignment.Left
            roleLbl.TextStrokeTransparency = 0
            roleLbl.ZIndex = library.multiZindex + 1
        end

        return group, groupbox
    end

    return tab
end
