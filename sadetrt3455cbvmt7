            local function renderSelected()
                for _, v in next, holder:GetChildren() do
                    if v.ClassName ~= "Frame" then continue end
                    v.off.TextColor3 = Color3.new(0.65, 0.65, 0.65)
                    for _, _v in next, library.flags[args.flag] do
                        if v.Name == _v then v.off.TextColor3 = Color3.new(1, 1, 1) end
                    end
                end
            end

            local function broadcastHostsChanged()
                if args.flag ~= "hosts_list" then return end
                for _, otherFlag in ipairs({"targets_list", "whitelist_list"}) do
                    local opt = library.options[otherFlag]
                    if opt and opt.refresh and opt.frame and opt.frame.Visible then
                        local f = (opt.searchBox and opt.searchBox.Text) or ""
                        opt.refresh(opt.values, f)
                        if opt.updateCounter then opt.updateCounter() end
                    end
                end
            end

            local function updateValue(value)
                if value == nil then valuetext.Text = "nil" return end
                if args.multiselect then
                    if type(value) == "string" then
                        if not table.find(library.options[args.flag].values, value) then return end
                        local idx = table.find(library.flags[args.flag], value)
                        if idx then table.remove(library.flags[args.flag], idx)
                        else table.insert(library.flags[args.flag], value) end
                    else
                        library.flags[args.flag] = value
                    end
                    local buttonText = ""
                    for i = 1, #library.flags[args.flag] do
                        local v = library.flags[args.flag][i]
                        local jig = i ~= #library.flags[args.flag] and "," or ""
                        buttonText = buttonText .. tostring(v) .. jig
                    end
                    if buttonText == "" then buttonText = "..." end
                    renderSelected()
                    valuetext.Text = buttonText
                    if args.callback then args.callback(library.flags[args.flag]) end
                    broadcastHostsChanged()
                else
                    if not table.find(library.options[args.flag].values, value) then
                        value = library.options[args.flag].values[1]
                    end
                    library.flags[args.flag] = value
                    for _, v in next, holder:GetChildren() do
                        if v.ClassName ~= "Frame" then continue end
                        v.off.TextColor3 = Color3.new(0.65, 0.65, 0.65)
                        if v.Name == library.flags[args.flag] then
                            v.off.TextColor3 = Color3.new(1, 1, 1)
                        end
                    end
                    frame.Visible = false
                    if library.flags[args.flag] then
                        valuetext.Text = library.flags[args.flag]
                        if args.callback then args.callback(library.flags[args.flag]) end
                    end
                end
            end

            local function updateCounter()
                if not args.multiselect then return end
                local n = #(library.flags[args.flag] or {})
                local base = args.text or args.flag
                text.Text = n > 0 and (base .. " [" .. n .. "]") or base
            end

            local function computeTotalHeight(rowCount)
                local visibleRows = math.min(rowCount, MAX_VISIBLE_ROWS)
                return SEARCH_H + visibleRows * ROW_HEIGHT + BULK_H + 6
            end

            local positionDropdown

            local function refresh(tbl, filter)
                filter = (filter or ""):lower()

                for _, v in next, holder:GetChildren() do
                    if v.ClassName == "Frame" then v:Destroy() end
                end

                local filtered = {}
                for _, v in pairs(tbl) do
                    local vs = tostring(v):lower()
                    local matched = false
                    if filter == "" then
                        matched = true
                    elseif string.find(vs, filter, 1, true) then
                        matched = true
                    else
                        local plr = players:FindFirstChild(tostring(v))
                        if plr then
                            local dn = plr.DisplayName:lower()
                            if string.find(dn, filter, 1, true) then
                                matched = true
                            end
                        end
                    end
                    if matched then
                        table.insert(filtered, v)
                    end
                end

                for _, v in pairs(filtered) do
                    local option = Instance.new("Frame")
                    local button_2 = Instance.new("TextButton")
                    local text_2 = Instance.new("TextLabel")

                    option.Name = tostring(v)
                    option.Parent = holder
                    option.BackgroundTransparency = 1
                    option.Size = UDim2.new(1, 0, 0, ROW_HEIGHT)

                    button_2.Parent = option
                    button_2.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
                    button_2.BackgroundTransparency = 0.85
                    button_2.BorderSizePixel = 0
                    button_2.Size = UDim2.new(1, 0, 1, 0)
                    button_2.Text = ""

                    text_2.Name = "off"
                    text_2.Parent = option
                    text_2.BackgroundTransparency = 1
                    text_2.Position = UDim2.new(0, 4, 0, 0)
                    text_2.Size = UDim2.new(1, 0, 1, 0)
                    text_2.Font = Enum.Font.Code

                    local display = tostring(v)
                    if showDisp then
                        local plr = players:FindFirstChild(display)
                        if plr and plr.DisplayName ~= plr.Name then
                            display = plr.DisplayName .. " (@" .. plr.Name .. ")"
                        end
                    end

                    if args.flag ~= "hosts_list" and isHostName(tostring(v)) then
                        display = "★ " .. display
                    end

                    text_2.Text = display
                    text_2.TextColor3 = args.multiselect and Color3.new(0.65, 0.65, 0.65) or Color3.new(1, 1, 1)
                    text_2.TextSize = 13
                    text_2.TextStrokeTransparency = 0
                    text_2.TextXAlignment = Enum.TextXAlignment.Left
                    text_2.TextTruncate = Enum.TextTruncate.AtEnd

                    button_2.MouseButton1Click:Connect(function() updateValue(tostring(v)) end)
                end

                local contentH   = #filtered * ROW_HEIGHT
                local visibleH   = math.min(contentH, MAX_LIST_HEIGHT)

                holder.CanvasSize = UDim2.new(0, 0, 0, contentH)
                holder.Size       = UDim2.new(1, 0, 0, visibleH)

                frame.Size = UDim2.new(0, FRAME_W, 0, computeTotalHeight(#filtered))

                if args.multiselect then renderSelected() end

                if frame.Visible and positionDropdown then
                    task.defer(function()
                        if frame.Visible then positionDropdown() end
                    end)
                end
            end

            positionDropdown = function()
                local cam = workspace.CurrentCamera
                local viewportH = cam and cam.ViewportSize.Y or 1080
                local frameH = frame.AbsoluteSize.Y
                if frameH <= 0 then
                    local opt = library.options[args.flag]
                    local curVals = (opt and opt.values) or args.values
                    frameH = computeTotalHeight(#curVals)
                end

                local listAbsY = list.AbsolutePosition.Y
                local listHeight = list.AbsoluteSize.Y
                if listHeight <= 0 then listHeight = 35 end

                local downBottom = listAbsY + listHeight + 12 + frameH
                if downBottom + FLIP_MARGIN > viewportH then
                    frame.Position = UDim2.new(0.03, -1, 0, -(frameH + 12))
                else
                    frame.Position = UDim2.new(0.03, -1, 1, 12)
                end
            end

            if searchBox then
                searchBox:GetPropertyChangedSignal("Text"):Connect(function()
                    refresh(args.values, searchBox.Text)
                end)
            end

            if btnAll then
                btnAll.MouseButton1Click:Connect(function()
                    if not args.multiselect then return end
                    library.flags[args.flag] = {}
                    for _, v in ipairs(args.values) do
                        table.insert(library.flags[args.flag], tostring(v))
                    end
                    renderSelected(); updateCounter()
                    if args.callback then args.callback(library.flags[args.flag]) end
                    broadcastHostsChanged()
                end)
                btnAll.MouseEnter:Connect(function() btnAll.BorderColor3 = library.libColor end)
                btnAll.MouseLeave:Connect(function() btnAll.BorderColor3 = Color3.fromRGB(60, 60, 60) end)
            end
            if btnNone then
                btnNone.MouseButton1Click:Connect(function()
                    if not args.multiselect then return end
                    library.flags[args.flag] = {}
                    renderSelected(); updateCounter()
                    if args.callback then args.callback(library.flags[args.flag]) end
                    broadcastHostsChanged()
                end)
                btnNone.MouseEnter:Connect(function() btnNone.BorderColor3 = library.libColor end)
                btnNone.MouseLeave:Connect(function() btnNone.BorderColor3 = Color3.fromRGB(60, 60, 60) end)
            end

            button.MouseButton1Click:Connect(function()
                if not library.colorpicking then
                    frame.Visible = not frame.Visible
                    if frame.Visible then
                        refresh(args.values, searchBox and searchBox.Text or "")
                        task.defer(function()
                            if frame.Visible then positionDropdown() end
                        end)
                    end
                end
            end)
            button.MouseEnter:Connect(function() main.BorderColor3 = library.libColor end)
            button.MouseLeave:Connect(function() main.BorderColor3 = Color3.fromRGB(60, 60, 60) end)

            table.insert(library.toInvis, frame)
            library.flags[args.flag] = args.multiselect and {} or ""
            library.options[args.flag] = {
                type = "list", changeState = updateValue,
                values = args.values, refresh = refresh,
                refreshFiltered = function(tbl, f) refresh(tbl, f) end,
                skipflag = args.skipflag, oldargs = args, updateCounter = updateCounter,
                searchBox = searchBox, positionDropdown = positionDropdown, frame = frame
            }

            refresh(args.values, "")
            if not args.multiselect then
                updateValue(args.value or args.values[1])
            else
                updateCounter()
            end
        end

        function group:addKeybind(args)
            if not args.flag then return warn("missing args on keybind") end
            groupbox.Size += UDim2.new(0, 0, 0, 20)

            local keybind = Instance.new("Frame")
            local text = Instance.new("TextLabel")
            local button = Instance.new("TextButton")

            keybind.Parent = grouper
