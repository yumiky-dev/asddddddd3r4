-- ============================================================
-- GROUP ACCESS CHECK
-- ============================================================
local GROUP_ID = 915657087
local MIN_RANK = 3

local accessGranted = false
local menu  -- forward declaration, assigned after the check passes

local function checkGroupAccess()
    local ok, rank = pcall(function()
        return localPlayer:GetRankInGroup(GROUP_ID)
    end)
    if not ok or type(rank) ~= "number" then return false end
    return rank >= MIN_RANK
end

local function enforceAccess()
    if checkGroupAccess() then
        accessGranted = true
        return true
    end
    accessGranted = false
    return false
end

local function revokeMenu()
    if menu and menu.Parent then
        pcall(function() menu:Destroy() end)
    end
end

if not enforceAccess() then
    return
end

localPlayer.CharacterAdded:Connect(function()
    task.defer(function()
        if not enforceAccess() then revokeMenu() end
    end)
end)

local lastServerId = game.JobId
runService.Heartbeat:Connect(function()
    if game.JobId ~= lastServerId then
        lastServerId = game.JobId
        if not enforceAccess() then revokeMenu() end
    end
end)
