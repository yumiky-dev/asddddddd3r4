            text.TextSize = 13
            text.TextStrokeTransparency = 0
            text.TextXAlignment = Enum.TextXAlignment.Left

            button.Parent = keybind
            button.BackgroundTransparency = 1
            button.BorderSizePixel = 0
            button.Position = UDim2.new(0.7, 0, 0, 0)
