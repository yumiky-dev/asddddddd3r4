function AutoShot:AddHost(plr)
    if not plr or plr == localPlayer then return false end
    for _, h in ipairs(self.Hosts) do
        if h == plr then return false end
    end
    table.insert(self.Hosts, plr)
    return true
end

function AutoShot:RemoveHost(plr)
    for i, h in ipairs(self.Hosts) do
        if h == plr then
            table.remove(self.Hosts, i)
            return true
        end
    end
    return false
end

function AutoShot:IsHost(plr)
    for _, h in ipairs(self.Hosts) do
        if h == plr then return true end
    end
    return false
end

local function IsAutoShotTarget(player)
    if not player or player == localPlayer then return false end
    if AutoShot.Mode == "All" then
        return GetRole(player) == "Target"
    else
        return AutoShot:IsHost(player)
    end
end

local function SimulateClick()
    pcall(function()
        if AutoShot.AutoShootRandomDelay then
            local randomDelay = AutoShot.AutoShootMinDelay
                + math.random() * (AutoShot.AutoShootMaxDelay - AutoShot.AutoShootMinDelay)
            task.wait(randomDelay)
        else
            task.wait(AutoShot.DelayBeforeShot)
        end

        mouse1press()
        task.wait(0.025 + math.random() * 0.015)
        mouse1release()
    end)
end

local function AutoShot_CheckShot()
    if not AutoShot.Monitoring then return end

    for _, starterPlayer in ipairs(players:GetPlayers()) do
        if starterPlayer == localPlayer then continue end
        if not IsAutoShotTarget(starterPlayer) then continue end

        local char = starterPlayer.Character
        if not char then continue end

        local tool = char:FindFirstChildOfClass("Tool")
        if not tool then continue end

        local toolName = tool.Name
        if not AutoShot.WeaponsEnabled[toolName] then continue end

        local ammo = tool:FindFirstChild(AutoShot.AmmoName)
        if not ammo or not ammo:IsA("IntValue") then continue end

        local curr = ammo.Value
        local prev = AutoShot.LastAmmoPerTool[tool]

        if prev ~= nil and curr < prev then
            if AutoShot.AutoShootBurstShots > 1 then
                task.spawn(function()
                    for i = 1, AutoShot.AutoShootBurstShots do
                        SimulateClick()
                        if i < AutoShot.AutoShootBurstShots then
                            task.wait(AutoShot.AutoShootBurstDelay)
                        end
                    end
                end)
            else
                SimulateClick()
            end
        end

        AutoShot.LastAmmoPerTool[tool] = curr
    end
end

local function AutoShot_CheckTripleShot()
    if not AutoShot.TripleShotEnabled then return end

    local char = localPlayer.Character
    if not char then return end

    local tool = char:FindFirstChildOfClass("Tool")
    if not tool or tool.Name ~= "[Double-Barrel SG]" then return end

    local ammo = tool:FindFirstChild(AutoShot.AmmoName)
    if not ammo or not ammo:IsA("IntValue") then return end

    local curr = ammo.Value
    local prev = AutoShot.LastAmmoPerTool[tool] or curr

    if prev ~= nil and curr < prev then
        local humanoid = char:FindFirstChild("Humanoid")
        if not humanoid then return end

        local backpack = localPlayer.Backpack
        local weapons = {"[Shotgun]", "[TacticalShotgun]", "[Revolver]"}

        for _, wpnName in ipairs(weapons) do
            local wpn = backpack:FindFirstChild(wpnName)
            if wpn then
                humanoid:EquipTool(wpn)
                task.wait(0.0000000000000000001)
                SimulateClick()
            end
        end

        local doublebarrel = backpack:FindFirstChild("[Double-Barrel SG]")
        if doublebarrel then
            humanoid:EquipTool(doublebarrel)
        end
    end

    AutoShot.LastAmmoPerTool[tool] = curr
end

local function AutoShot_connectAmmoWatcher(char)
    if not char then return end

    local function watchTool(tool)
        if not tool or not tool.Name then return end
        if not AutoShot.WeaponsEnabled[tool.Name] then return end
        local ammo = tool:FindFirstChild(AutoShot.AmmoName)
        if not ammo or not ammo:IsA("IntValue") then return end
        ammo.Changed:Connect(function() end)
    end

    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Tool") then watchTool(obj) end
    end

    char.ChildAdded:Connect(function(obj)
        if obj:IsA("Tool") then
            task.wait(0.05)
            if obj and obj.Parent then watchTool(obj) end
        end
    end)
end

localPlayer.CharacterAdded:Connect(AutoShot_connectAmmoWatcher)
if localPlayer.Character then AutoShot_connectAmmoWatcher(localPlayer.Character) end

