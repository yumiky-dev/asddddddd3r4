function isHostName(name)
    local hosts = library.flags["hosts_list"]
    if type(hosts) ~= "table" then return false end
    return table.find(hosts, name) ~= nil
end

local function draggable(a)
    local c, d, e, f
    a.InputBegan:Connect(function(h)
        if h.UserInputType == Enum.UserInputType.MouseButton1
            or h.UserInputType == Enum.UserInputType.Touch then
            c = true; e = h.Position; f = a.Position
            h.Changed:Connect(function()
                if h.UserInputState == Enum.UserInputState.End then c = false end
            end)
        end
    end)
    a.InputChanged:Connect(function(h)
        if h.UserInputType == Enum.UserInputType.MouseMovement
            or h.UserInputType == Enum.UserInputType.Touch then d = h end
    end)
    inputService.InputChanged:Connect(function(h)
        if h == d and c and not library.colorpicking then
            local i = h.Position - e
            a.Position = UDim2.new(f.X.Scale, f.X.Offset + i.X, f.Y.Scale, f.Y.Offset + i.Y)
        end
    end)
end
